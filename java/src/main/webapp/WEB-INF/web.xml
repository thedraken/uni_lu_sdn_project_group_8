<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
         version="3.0">
    <display-name>SDN Traffic Monitor REST API</display-name>

    <!-- Authenticate every request with HTTP BASIC against ONOS's Karaf user
         realm. This is what populates the SecurityContext (user + JAAS roles)
         that Role.of() reads; without a login-config the context is never
         established and every call is rejected.

         The auth-constraint is the COARSE gate: a caller must hold one of our
         three roles just to get in. The FINE-grained "observer vs operator vs
         admin" decision is then made per-endpoint in MonitorWebResource. We
         list all three here so the container lets any valid monitor user
         through and leaves the real RBAC to our code. -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>monitor</web-resource-name>
            <url-pattern>/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>admin</role-name>
            <role-name>operator</role-name>
            <role-name>observer</role-name>
        </auth-constraint>
    </security-constraint>

    <security-role><role-name>admin</role-name></security-role>
    <security-role><role-name>operator</role-name></security-role>
    <security-role><role-name>observer</role-name></security-role>

    <login-config>
        <auth-method>BASIC</auth-method>
        <realm-name>karaf</realm-name>
    </login-config>

    <servlet>
        <servlet-name>JAX-RS Service</servlet-name>
        <servlet-class>org.glassfish.jersey.servlet.ServletContainer</servlet-class>
        <init-param>
            <param-name>javax.ws.rs.Application</param-name>
            <param-value>org.uni.lu.MonitorWebApplication</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <servlet-mapping>
        <servlet-name>JAX-RS Service</servlet-name>
        <url-pattern>/*</url-pattern>
    </servlet-mapping>
</web-app>
